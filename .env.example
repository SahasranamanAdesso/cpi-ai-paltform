# Normally managed from iFlow Studio: gear icon at the top right -> Save.
# Primary model: always tried first
AI_HUB_API_KEY=
AI_HUB_URL=https://adesso-ai-hub.3asabc.de/v1
AI_HUB_MODEL=gemma-4-26b-sovereign
# Secondary model (optional): used when the primary model fails
AI_HUB_SECONDARY_API_KEY=
AI_HUB_SECONDARY_URL=https://adesso-ai-hub.3asabc.de/v1
AI_HUB_SECONDARY_MODEL=claude-sonnet-4-6
# CPI tenant (optional, for Deploy): from a Process Integration Runtime service key, plan "api"
CPI_CLIENT_ID=
CPI_CLIENT_SECRET=
CPI_TOKEN_URL=
CPI_API_BASE_URL=
CPI_PACKAGE_ID=cpipackage
