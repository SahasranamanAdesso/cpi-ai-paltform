<mvc:View
    controllerName="iflowstudio.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        id="mainPage"
        showHeader="false"
        class="sapUiResponsiveContentPadding">

        <content>

            <!-- Header -->
            <VBox class="heroSection">

                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="topBar">

                    <HBox alignItems="Center">
                        <core:Icon
                            src="sap-icon://process"
                            size="2rem"
                            class="appIcon"/>

                        <VBox class="sapUiSmallMarginBegin">
                            <Title
                                text="iFlow Studio"
                                level="H2"/>

                            <Text
                                text="Build SAP Integration Flows from natural language"/>
                        </VBox>
                    </HBox>

                    <HBox alignItems="Center">

                        <ObjectStatus
                            text="{setup>/headerText}"
                            state="{setup>/headerState}"
                            icon="{setup>/headerIcon}"
                            active="true"
                            press=".onOpenSetup"
                            tooltip="{setup>/lastFallbackReason}"/>

                        <Button
                            icon="sap-icon://action-settings"
                            tooltip="AI Hub connection settings"
                            type="Transparent"
                            press=".onOpenSetup"
                            class="sapUiSmallMarginBegin"/>

                    </HBox>
                </HBox>


                <!-- Hero -->
                <VBox class="heroContent">

                    <Title
                        text="Create an Integration Flow"
                        level="H1"
                        class="heroTitle"/>

                    <Text
                        text="Describe the integration you need. iFlow Studio will turn your scenario into an SAP Integration Flow."
                        class="heroSubtitle"/>

                </VBox>

            </VBox>


            <!-- Scenario Card -->
            <Panel
                headerText="Describe your scenario"
                class="scenarioCard"
                expandable="false">

                <content>

                    <VBox>

                        <Text
                            text="You don't need to know SAP Integration Suite components. Just describe the business requirement."
                            class="scenarioHint"/>

                        <TextArea
                            id="scenarioInput"
                            width="100%"
                            rows="8"
                            growing="true"
                            maxLength="5000"
                            placeholder="Example:

Receive orders through HTTPS. Validate the order. Route domestic and international orders differently. Enrich international orders and finally send the result to an HTTP service."
                            value="{view>/scenario}"
                            class="scenarioInput"/>


                        <!-- Examples -->
                        <HBox
                            wrap="Wrap"
                            class="exampleRow">

                            <Button
                                text="Order processing"
                                icon="sap-icon://example"
                                type="Transparent"
                                press=".onExamplePress"/>

                            <Button
                                text="Customer synchronization"
                                icon="sap-icon://customer"
                                type="Transparent"
                                press=".onExamplePress"/>

                            <Button
                                text="Invoice integration"
                                icon="sap-icon://receipt"
                                type="Transparent"
                                press=".onExamplePress"/>

                            <Button
                                text="API transformation"
                                icon="sap-icon://process"
                                type="Transparent"
                                press=".onExamplePress"/>

                        </HBox>


                        <!-- Generate -->
                        <HBox
                            justifyContent="End"
                            class="generateRow">

                            <Button
                                id="deployButton"
                                text="Deploy to CPI"
                                icon="sap-icon://upload-to-cloud"
                                press=".onDeploy"
                                enabled="{= ${deploy>/status} !== 'RUNNING' }"
                                tooltip="Deploy the flow you generated (or generate one from the scenario if you have not yet) to your CPI tenant"
                                class="sapUiSmallMarginEnd"/>

                            <Button
                                id="generateButton"
                                text="Generate Integration Flow"
                                icon="sap-icon://process"
                                type="Emphasized"
                                press=".onGenerateIntegrationFlow"
                                busy="{view>/generating}"
                                enabled="{= !${view>/generating} }"
                                class="generateButton"/>

                        </HBox>

                    </VBox>

                </content>

            </Panel>


            <!-- Deployment -->
            <Panel
                id="deployPanel"
                headerText="Deployment"
                visible="{= !!${deploy>/deploymentId} }"
                class="scenarioCard">

                <content>

                    <VBox>

                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Center">

                            <VBox>
                                <Title
                                    text="{= ${deploy>/artifactId} ? ${deploy>/artifactId} : 'New integration flow' }"
                                    level="H3"/>
                                <Text
                                    text="{= 'Package ' + ${deploy>/packageId} + ' · attempt ' + ${deploy>/attempt} + ' of ' + ${deploy>/maxAttempts} }"/>
                            </VBox>

                            <ObjectStatus
                                text="{deploy>/statusText}"
                                state="{deploy>/statusState}"
                                icon="{deploy>/statusIcon}"
                                class="sapMObjectStatusLarge"/>

                        </HBox>

                        <HBox
                            alignItems="Center"
                            visible="{= ${deploy>/status} === 'RUNNING' }"
                            class="sapUiSmallMarginTop">
                            <BusyIndicator size="1rem" class="sapUiTinyMarginEnd"/>
                            <Text text="{deploy>/phase}"/>
                        </HBox>

                        <MessageStrip
                            visible="{= ${deploy>/status} === 'STARTED' }"
                            type="Success"
                            showIcon="true"
                            text="{deploy>/phase}"
                            class="sapUiSmallMarginTop"/>

                        <!-- Error details -->
                        <VBox
                            visible="{= !!${deploy>/error} &amp;&amp; ${deploy>/status} !== 'RUNNING' }"
                            class="sapUiSmallMarginTop">

                            <MessageStrip
                                type="Error"
                                showIcon="true"
                                text="{deploy>/phase}"/>

                            <Label
                                text="Error reported by SAP"
                                design="Bold"
                                class="sapUiSmallMarginTop"/>

                            <TextArea
                                value="{deploy>/error}"
                                editable="false"
                                growing="true"
                                growingMaxLines="12"
                                width="100%"
                                class="deployError"/>

                            <Panel
                                expandable="true"
                                expanded="false"
                                headerText="Raw error details"
                                visible="{= !!${deploy>/errorDetail} }">
                                <TextArea
                                    value="{deploy>/errorDetail}"
                                    editable="false"
                                    growing="true"
                                    growingMaxLines="20"
                                    width="100%"
                                    class="deployError"/>
                            </Panel>

                        </VBox>

                        <Toolbar
                            visible="{= ${deploy>/status} !== 'RUNNING' }"
                            style="Clear"
                            class="sapUiSmallMarginTop">

                            <ToolbarSpacer/>

                            <Button
                                text="Fix &amp; Redeploy"
                                icon="sap-icon://wrench"
                                type="Emphasized"
                                visible="{deploy>/canFix}"
                                tooltip="Send the SAP error to the AI, regenerate the flow and deploy it again"
                                press=".onFixAndRedeploy"/>

                            <Button
                                text="Deploy again"
                                icon="sap-icon://upload-to-cloud"
                                visible="{= ${deploy>/status} === 'STARTED' }"
                                press=".onDeploy"/>

                        </Toolbar>

                    </VBox>

                </content>

            </Panel>


            <!-- Tenant errors -->
            <Panel
                headerText="Flows with deployment errors on the tenant"
                expandable="true"
                expanded="false"
                expand=".onTenantErrorsExpand"
                class="scenarioCard">

                <headerToolbar>
                    <Toolbar>
                        <Title text="Flows with deployment errors on the tenant" level="H4"/>
                        <ToolbarSpacer/>
                        <Button
                            icon="sap-icon://refresh"
                            text="Check"
                            tooltip="Load all flows currently in ERROR status"
                            busy="{deploy>/loadingErrors}"
                            press=".onLoadTenantErrors"/>
                    </Toolbar>
                </headerToolbar>

                <content>

                    <VBox>

                        <Text
                            visible="{= !${deploy>/tenantErrorsLoaded} }"
                            text="Click Check to load flows that are currently in ERROR status on your CPI tenant."/>

                        <MessageStrip
                            visible="{= !!${deploy>/tenantErrorsMessage} }"
                            text="{deploy>/tenantErrorsMessage}"
                            type="{deploy>/tenantErrorsMessageType}"
                            showIcon="true"/>

                        <List
                            items="{deploy>/tenantErrors}"
                            visible="{= ${deploy>/tenantErrors}.length > 0 }"
                            noDataText="No flows in ERROR status.">
                            <CustomListItem>
                                <VBox class="sapUiSmallMargin">
                                    <HBox justifyContent="SpaceBetween">
                                        <Title text="{deploy>artifactName}" level="H5"/>
                                        <ObjectStatus text="ERROR" state="Error" icon="sap-icon://status-negative"/>
                                    </HBox>
                                    <Text
                                        text="{= ${deploy>artifactId} + (${deploy>deployedBy} ? ' · deployed by ' + ${deploy>deployedBy} : '') }"
                                        class="setupHelp"/>
                                    <Text
                                        text="{deploy>error}"
                                        wrapping="true"
                                        class="sapUiTinyMarginTop deployErrorText"/>
                                </VBox>
                            </CustomListItem>
                        </List>

                    </VBox>

                </content>

            </Panel>


            <!-- Generated Flow -->
            <Panel
                id="flowPanel"
                headerText="Generated Integration Flow"
                visible="{view>/generated}"
                class="flowCard">

                <content>

                    <VBox>

                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                            class="flowHeader">

                            <VBox>

                                <Title
                                    text="{view>/flowName}"
                                    level="H3"/>

                                <Text
                                    text="Generated from your business scenario"/>

                            </VBox>

                            <ObjectStatus
                                text="Generated"
                                state="Success"
                                icon="sap-icon://status-positive"/>

                        </HBox>


                        <!-- Flow visualization -->
                        <HBox
                            id="flowVisualization"
                            justifyContent="Center"
                            alignItems="Center"
                            wrap="Wrap"
                            class="flowVisualization">

                        </HBox>


                        <!-- Validation -->
                        <MessageStrip
                            text="Integration flow generated successfully. You can validate it before downloading the SAP artifact."
                            type="Success"
                            showIcon="true"
                            class="sapUiMediumMarginTop"/>


                        <!-- Actions -->
                        <Toolbar class="actionToolbar">

                            <ToolbarSpacer/>

                            <Button
                                text="Validate"
                                icon="sap-icon://validate"
                                press=".onValidate"/>

                            <Button
                                text="Edit Scenario"
                                icon="sap-icon://edit"
                                press=".onEdit"/>

                            <Button
                                text="Download .zip"
                                icon="sap-icon://download"
                                type="Emphasized"
                                press=".onDownload"/>

                        </Toolbar>

                    </VBox>

                </content>

            </Panel>

        </content>

    </Page>

</mvc:View>